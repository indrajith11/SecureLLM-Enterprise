# Copy to .env (or export) before running.
# Model provider: auto | mock | ollama
#   auto   -> use Ollama (qwen2.5:0.5b) if reachable, else built-in mock model
#   mock   -> built-in deterministic test model (no downloads, always works)
#   ollama -> require Ollama at OLLAMA_URL
MODEL_PROVIDER=auto

# SECURE_MODE=true  -> all 7 security layers active (this is the product)
# SECURE_MODE=false -> L2/L6 disabled: measures how vulnerable the RAW model is
#                      (used only for the baseline vulnerability report)
SECURE_MODE=true

# JWT signing secret. If empty, one is generated and stored in secrets.json.
# In production, inject from a secrets manager / KMS, never from a file.
JWT_SECRET=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

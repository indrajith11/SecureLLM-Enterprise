# Copy to .env (or export) before running.
# Model provider: auto | mock | ollama | colibri
#   auto    -> use Ollama (qwen2.5:0.5b) if reachable, else built-in mock model
#   mock    -> built-in deterministic test model (no downloads, always works)
#   ollama  -> require Ollama at OLLAMA_URL
#   colibri -> OpenAI-compatible frontier-MoE server (coli serve) at COLIBRI_URL
#              explicit opt-in only; hardware floors: docs/colibri.md
MODEL_PROVIDER=auto

# colibri backend (v4.3.0) - only used when MODEL_PROVIDER=colibri
# COLIBRI_URL=http://localhost:8000
# COLIBRI_API_KEY=            # set when coli serve runs with COLI_API_KEY
# COLIBRI_MODEL=glm-5.2-colibri

# SECURE_MODE=true  -> all 7 security layers active (this is the product)
# SECURE_MODE=false -> L2/L6/CIA disabled: measures how vulnerable the RAW
#                      model is (baseline vulnerability report ONLY).
#                      DEPLOY-03: refused at boot unless BOTH
#                      ENV=dev|baseline AND ALLOW_INSECURE_BASELINE=1 are set,
#                      so the product can no longer be disarmed by one var.
SECURE_MODE=true
# ENV=dev
# ALLOW_INSECURE_BASELINE=1

# JWT signing secret (DEPLOY-01). Resolution order:
#   1) JWT_SECRET env (production: inject from a secrets manager / KMS)
#   2) session.jwt_secret in config/app_config.yaml (dev convenience)
#   3) secrets.json written under SECRETS_DIR (writable path)
# If no source is available the app FAILS FAST instead of starting insecurely.
JWT_SECRET=
# SECRETS_DIR=/tmp/secrets

# DASH-04: when set, /metrics requires this bearer token from scrapers.
# METRICS_TOKEN=

# RAG-04: dedicated HMAC key for the audit hash chain. Falls back to a
# value derived from the JWT secret when unset.
# AUDIT_HMAC_KEY=

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b

# --- Wave 6: Telegram company bot (optional; off unless telegram.enabled)
# Users log in with their OWN company credentials (/login). No shared
# service account exists. USER_MAP is an OPTIONAL extra gate: empty = any
# member of an allowed chat may /login with their own credentials.
# TELEGRAM_BOT_TOKEN=123456:ABC-from-BotFather
# TELEGRAM_ALLOWED_CHATS=-1001234567890
# TELEGRAM_USER_MAP=

# --- Wave 6: MCP server / client (optional; off unless mcp.enabled)
# MCP_SERVICE_USER=mcp_bridge
# MCP_SERVICE_PASSWORD=change-me
# SECURELLM_API_URL=http://localhost:8000
